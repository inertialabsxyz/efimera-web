---
import { Image } from "astro:assets";
import { getLocalePath, t, type Locale } from "../lib/i18n";

interface Props {
    title: string;
    slug: string;
    category: string;
    image?: string;
    excerpt?: string;
    featured?: boolean;
    lang?: Locale;
}

const { title, slug, category, image, excerpt, featured = false, lang = "es" } = Astro.props;

// Placeholder image if none provided
const imageUrl = image || `https://picsum.photos/seed/${slug}/800/600`;
---

<a href={getLocalePath(`/article/${slug}`, lang)} class:list={["article-card", { featured }]}>
    <span class="article-card-category">{t(`cat.${category}`, lang) !== `cat.${category}` ? t(`cat.${category}`, lang) : category}</span>
    <div class="article-card-image">
        <Image
            src={imageUrl}
            alt={title}
            width={800}
            height={600}
            loading="lazy"
            decoding="async"
        />
    </div>
    <div class="article-card-content">
        <h2 class="article-card-title">{title}</h2>
        {excerpt && <p class="article-card-excerpt">{excerpt}</p>}
    </div>
</a>
