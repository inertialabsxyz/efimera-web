---
import { urlFor } from "../lib/sanity";
import { getLocalePath, t, type Locale } from "../lib/i18n";

interface Props {
    items: any[];
    lang?: Locale;
}

const { items, lang = "es" } = Astro.props;

const cards = (items || []).slice(0, 3).map((item) => {
    const slug = item.slug?.current;
    return {
        kicker: item.category,
        title: item.title,
        excerpt: item.excerpt,
        href: slug ? getLocalePath(`/article/${slug}`, lang) : null,
        image: item.mainImage
            ? urlFor(item.mainImage).width(800).height(600).fit("crop").url()
            : null,
    };
});
---

{
    cards.length > 0 && (
        <section class="home-feature">
            <h2 class="sr-only">{t("home.latest", lang)}</h2>
            <div class="home-feature-inner">
                <ul class="home-feature-cards">
                    {cards.map((card) => (
                        <li class="home-feature-card">
                            {card.href ? (
                                <a href={card.href}>
                                    {card.image && (
                                        <div class="home-feature-media">
                                            <img
                                                src={card.image}
                                                alt=""
                                                width="800"
                                                height="600"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        </div>
                                    )}
                                    {card.kicker && (
                                        <p class="home-feature-kicker">
                                            {card.kicker}
                                        </p>
                                    )}
                                    <h3 class="home-feature-title">
                                        {card.title}
                                    </h3>
                                    {card.excerpt && (
                                        <p class="home-feature-excerpt">
                                            {card.excerpt}
                                        </p>
                                    )}
                                    <span class="home-feature-more">
                                        <span class="sr-only">
                                            {card.title}
                                        </span>
                                        <svg
                                            width="28"
                                            height="10"
                                            viewBox="0 0 28 10"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1"
                                            aria-hidden="true"
                                            focusable="false"
                                        >
                                            <path d="M0 5h26M22 1l4 4-4 4" />
                                        </svg>
                                    </span>
                                </a>
                            ) : null}
                        </li>
                    ))}
                </ul>

                <aside class="home-feature-aside">
                    <p class="home-feature-tagline">{t("home.tagline", lang)}</p>
                    <hr class="home-feature-rule" />
                    <ul class="home-feature-links">
                        <li>
                            <a href={getLocalePath("/about", lang)}>
                                {t("home.about", lang)}
                            </a>
                        </li>
                        <li>
                            <a href={getLocalePath("/#newsletter", lang)}>
                                {t("home.newsletter", lang)}
                            </a>
                        </li>
                        <li>
                            <a href={getLocalePath("/contact", lang)}>
                                {t("home.contacto", lang)}
                            </a>
                        </li>
                    </ul>
                </aside>
            </div>
        </section>
    )
}

<style>
    .home-feature {
        padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    }

    .home-feature-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--space-md);
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
        grid-template-columns: 1fr;
    }

    @media (min-width: 1000px) {
        .home-feature-inner {
            grid-template-columns: minmax(0, 1fr) minmax(180px, 15rem);
        }
    }

    .home-feature-cards {
        list-style: none;
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.5rem);
        grid-template-columns: 1fr;
    }

    /* First card carries more weight so the row has a reading order */
    @media (min-width: 700px) {
        .home-feature-cards {
            grid-template-columns: 1.25fr 1fr 1fr;
            align-items: start;
        }

        .home-feature-card:not(:first-child) {
            padding-top: clamp(1.5rem, 4vw, 3rem);
        }
    }

    .home-feature-media {
        overflow: hidden;
        margin-bottom: clamp(0.75rem, 2vw, 1.25rem);
    }

    .home-feature-media img {
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        transition: transform 0.45s ease;
    }

    .home-feature-card a:hover .home-feature-media img,
    .home-feature-card a:focus-visible .home-feature-media img {
        transform: scale(1.03);
    }

    .home-feature-kicker {
        font-size: 0.68rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: 0.5rem;
    }

    .home-feature-title {
        font-family: var(--font-display);
        font-size: clamp(1.1rem, 1.9vw, 1.5rem);
        text-transform: uppercase;
        line-height: 1.15;
        margin-bottom: 0.5rem;
    }

    .home-feature-excerpt {
        font-size: 0.9rem;
        line-height: 1.5;
        color: var(--color-text-muted);
        max-width: 30ch;
        margin-bottom: clamp(1rem, 2.5vw, 1.5rem);
    }

    .home-feature-more {
        display: inline-block;
    }

    .home-feature-more svg {
        transition: transform 0.25s ease;
    }

    .home-feature-card a:hover .home-feature-more svg,
    .home-feature-card a:focus-visible .home-feature-more svg {
        transform: translateX(4px);
    }

    /* Sidebar — given room rather than squeezed into a gutter */
    .home-feature-aside {
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 3vw, 2rem);
    }

    @media (min-width: 1000px) {
        .home-feature-aside {
            border-left: 1px solid var(--color-border);
            padding-left: clamp(1.5rem, 3vw, 2.5rem);
        }
    }

    .home-feature-tagline {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(1.1rem, 1.6vw, 1.35rem);
        line-height: 1.35;
        max-width: 24ch;
    }

    .home-feature-rule {
        border: 0;
        border-top: 1px solid var(--color-border);
        width: 2.5rem;
        margin: 0;
    }

    .home-feature-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .home-feature-links a {
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
        transition: border-color 0.2s ease;
    }

    .home-feature-links a:hover,
    .home-feature-links a:focus-visible {
        border-bottom-color: currentColor;
    }

    @media (prefers-reduced-motion: reduce) {
        .home-feature-media img,
        .home-feature-more svg {
            transition: none;
        }
    }
</style>
