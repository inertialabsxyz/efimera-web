---
import { urlFor } from "../lib/sanity";
import { getLocalePath, t, type Locale } from "../lib/i18n";
import EditorialCard from "./EditorialCard.astro";

interface Props {
    items: any[];
    lang?: Locale;
}

const { items, lang = "es" } = Astro.props;

const cards = (items || []).slice(0, 3).map((item) => {
    const slug = item.slug?.current;
    return {
        kicker: item.category,
        title: item.title,
        excerpt: item.excerpt,
        href: slug ? getLocalePath(`/article/${slug}`, lang) : null,
        image: item.mainImage
            ? urlFor(item.mainImage).width(800).height(600).fit("crop").url()
            : null,
    };
});
---

{
    cards.length > 0 && (
        <section class="home-feature">
            <h2 class="sr-only">{t("home.latest", lang)}</h2>
            <div class="home-feature-inner">
                <ul class="home-feature-cards">
                    {cards.map((card) => (
                        <li class="home-feature-card">
                            <EditorialCard
                                title={card.title}
                                href={card.href}
                                image={card.image}
                                kicker={card.kicker}
                                excerpt={card.excerpt}
                                lang={lang}
                            />
                        </li>
                    ))}
                </ul>

                <aside class="home-feature-aside">
                    <p class="home-feature-tagline">{t("home.tagline", lang)}</p>
                    <hr class="home-feature-rule" />
                    <ul class="home-feature-links">
                        <li>
                            <a href={getLocalePath("/about", lang)}>
                                {t("home.about", lang)}
                            </a>
                        </li>
                        <li>
                            <a href={getLocalePath("/#newsletter", lang)}>
                                {t("home.newsletter", lang)}
                            </a>
                        </li>
                        <li>
                            <a href={getLocalePath("/contact", lang)}>
                                {t("home.contacto", lang)}
                            </a>
                        </li>
                    </ul>
                </aside>
            </div>
        </section>
    )
}

<style>
    .home-feature {
        padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    }

    .home-feature-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--space-md);
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
        grid-template-columns: 1fr;
    }

    @media (min-width: 1000px) {
        .home-feature-inner {
            grid-template-columns: minmax(0, 1fr) minmax(180px, 15rem);
        }
    }

    .home-feature-cards {
        list-style: none;
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.5rem);
        grid-template-columns: 1fr;
    }

    /* First card carries more weight so the row has a reading order */
    @media (min-width: 700px) {
        .home-feature-cards {
            /* Equal columns so every card image is the same size. The
               vertical stagger is dropped for the same reason. */
            grid-template-columns: repeat(3, 1fr);
            align-items: start;
        }
    }










    /* Sidebar — given room rather than squeezed into a gutter */
    .home-feature-aside {
        display: flex;
        flex-direction: column;
        gap: clamp(1.25rem, 3vw, 2rem);
    }

    @media (min-width: 1000px) {
        .home-feature-aside {
            border-left: 1px solid var(--color-border);
            padding-left: clamp(1.5rem, 3vw, 2.5rem);
        }
    }

    .home-feature-tagline {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(1.1rem, 1.6vw, 1.35rem);
        line-height: 1.35;
        max-width: 24ch;
    }

    .home-feature-rule {
        border: 0;
        border-top: 1px solid var(--color-border);
        width: 2.5rem;
        margin: 0;
    }

    .home-feature-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .home-feature-links a {
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
        transition: border-color 0.2s ease;
    }

    .home-feature-links a:hover,
    .home-feature-links a:focus-visible {
        border-bottom-color: currentColor;
    }

</style>
