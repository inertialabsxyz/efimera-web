---
import { urlFor } from "../lib/sanity";
import { getLocalePath, t, type Locale } from "../lib/i18n";

interface Props {
    /** Featured gallery slides; each carries its own text, dates and rail */
    slides: any[];
    lang?: Locale;
}

const { slides = [], lang = "es" } = Astro.props;

const locale = lang === "en" ? "en-GB" : "es-ES";

// "16 octubre" / "16 octubre 2026" — year only when asked for
function formatDate(value?: string, withYear = true) {
    if (!value) return null;
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return null;
    const formatted = new Intl.DateTimeFormat(locale, {
        day: "numeric",
        month: "long",
        ...(withYear ? { year: "numeric" } : {}),
        timeZone: "UTC",
    }).format(date);
    // Spanish renders "16 de octubre de 2026"; the design wants "16 octubre 2026"
    return lang === "es" ? formatted.replace(/ de /g, " ") : formatted;
}

// Build the date range label, dropping the repeated year when both dates
// fall in the same one.
function dateRangeFor(startValue?: string, endValue?: string) {
    if (!startValue && !endValue) return null;
    const s = startValue ? new Date(startValue) : null;
    const e = endValue ? new Date(endValue) : null;
    const sameYear =
        s &&
        e &&
        !Number.isNaN(s.getTime()) &&
        !Number.isNaN(e.getTime()) &&
        s.getUTCFullYear() === e.getUTCFullYear();
    return (
        [formatDate(startValue, !sameYear), formatDate(endValue)]
            .filter(Boolean)
            .join(" — ") || null
    );
}

function hrefFor(url?: string, slug?: string) {
    if (url) return url;
    return slug ? getLocalePath(`/article/${slug}`, lang) : null;
}

// Each gallery slide carries its own text; anything the editor leaves blank
// falls back to the linked article, then to the hero defaults.
const gallerySlides = slides
    .map((slide: any) => {
        const isRevista = slide?._type === "revistaSlide";
        const source = isRevista ? slide?.revista?.coverImage : slide?.image;
        if (!source) return null;

        const article = slide?.article;
        const title = slide?.title || article?.title || slide?.revista?.title;
        if (!title) return null;

        return {
            src: urlFor(source).width(1400).height(1000).fit("crop").url(),
            alt: source?.alt || title,
            eyebrow: slide?.eyebrow || article?.category || null,
            title,
            excerpt: slide?.excerpt || article?.excerpt || null,
            dateRange: dateRangeFor(
                slide?.startDate || article?.publishedAt,
                slide?.endDate,
            ),
            href: hrefFor(
                slide?.url || (isRevista ? slide?.revista?.pdfUrl : undefined),
                article?.slug?.current,
            ),
            isExternal: Boolean(
                slide?.url || (isRevista && slide?.revista?.pdfUrl),
            ),
            discipline: slide?.discipline || null,
            themes: Array.isArray(slide?.themes) ? slide.themes : [],
            location: slide?.location || null,
            ctaLabel: slide?.ctaLabel || t("home.heroCta", lang),
        };
    })
    .filter(Boolean) as any[];

const heroSlides = gallerySlides;

const hasMultiple = heroSlides.length > 1;
---

<section class="home-hero">
    <div class="home-hero-inner">
        <div class="home-hero-text">
            {
                heroSlides.map((slide, i) => (
                    <div
                        class:list={["home-hero-copy", { active: i === 0 }]}
                        data-hero-copy
                    >
                        {slide.eyebrow && (
                            <p class="home-hero-eyebrow">{slide.eyebrow}</p>
                        )}
                        <h1 class="home-hero-title">{slide.title}</h1>
                        {slide.excerpt && (
                            <p class="home-hero-subtitle">{slide.excerpt}</p>
                        )}
                        {slide.dateRange && (
                            <p class="home-hero-dates">{slide.dateRange}</p>
                        )}
                        {slide.href && (
                            <a
                                class="home-hero-cta"
                                href={slide.href}
                                tabindex={i === 0 ? undefined : -1}
                                {...(slide.isExternal
                                    ? {
                                          target: "_blank",
                                          rel: "noopener noreferrer",
                                      }
                                    : {})}
                            >
                                <span>{slide.ctaLabel}</span>
                                <svg
                                    class="home-hero-arrow"
                                    width="28"
                                    height="10"
                                    viewBox="0 0 28 10"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1"
                                    aria-hidden="true"
                                    focusable="false"
                                >
                                    <path d="M0 5h26M22 1l4 4-4 4" />
                                </svg>
                            </a>
                        )}
                    </div>
                ))
            }
        </div>

        {
            heroSlides.length > 0 && (
                <div
                    class="home-hero-media"
                    data-hero-gallery={hasMultiple ? "" : null}
                >
                    <div class="home-hero-track" data-hero-track>
                        {heroSlides.map((slide, i) => (
                            <img
                                class:list={[
                                    "home-hero-slide",
                                    { active: i === 0 },
                                ]}
                                src={slide.src}
                                alt={i === 0 ? slide.alt : ""}
                                width="1400"
                                height="1000"
                                fetchpriority={i === 0 ? "high" : undefined}
                                loading={i === 0 ? undefined : "lazy"}
                                decoding="async"
                            />
                        ))}
                    </div>

                    {hasMultiple && (
                        <div class="home-hero-dots" data-hero-dots>
                            {heroSlides.map((_, i) => (
                                <button
                                    type="button"
                                    class:list={[
                                        "home-hero-dot",
                                        { active: i === 0 },
                                    ]}
                                    data-index={i}
                                    aria-label={`${i + 1} / ${heroSlides.length}`}
                                />
                            ))}
                        </div>
                    )}
                </div>
            )
        }

        {
            heroSlides.some(
                (s) => s.discipline || s.themes.length > 0 || s.location,
            ) && (
                <aside class="home-hero-rail">
                    {heroSlides.map((slide, i) => (
                        <div
                            class:list={["home-hero-railset", { active: i === 0 }]}
                            data-hero-rail
                        >
                            {slide.discipline && (
                                <p class="home-hero-discipline">
                                    {slide.discipline}
                                </p>
                            )}
                            {slide.themes.length > 0 && (
                                <ul class="home-hero-themes">
                                    {slide.themes.map((theme: string) => (
                                        <li>{theme}</li>
                                    ))}
                                </ul>
                            )}
                            {slide.location && (
                                <p class="home-hero-location">
                                    {slide.location}
                                </p>
                            )}
                        </div>
                    ))}
                </aside>
            )
        }
    </div>
</section>

<style>
    .home-hero {
        background: var(--color-feature);
        color: var(--color-feature-text);
        /* Breathing room under the header; the layout adds header height
           on top of this via --hero-gap. */
        --hero-gap: clamp(1.25rem, 3vw, 2.25rem);
        padding: var(--hero-gap) 0 0;
    }

    /* Fill more of the fold on desktop, as in the design */
    @media (min-width: 900px) {
        .home-hero {
            display: flex;
            align-items: flex-end;
        }

        .home-hero-inner {
            width: 100%;
        }
    }

    .home-hero-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--space-md);
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        grid-template-columns: 1fr;
        align-items: start;
    }

    /* Text — bleeds left, image offset right, rail last */
    @media (min-width: 900px) {
        .home-hero-inner {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr) auto;
            column-gap: clamp(2rem, 5vw, 4rem);
            padding-bottom: 0;
        }
    }

    .home-hero-text {
        padding-bottom: clamp(2rem, 5vw, 4rem);
        display: grid;
    }

    /* Copy blocks stack and crossfade in step with the image */
    .home-hero-copy {
        grid-area: 1 / 1;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.25s ease,
            visibility 0s linear 0.25s;
    }

    .home-hero-copy.active {
        opacity: 1;
        visibility: visible;
        transition:
            opacity 0.35s ease 0.15s,
            visibility 0s;
    }

    /* The image runs to the bottom edge of the blue; text and rail keep
       their breathing room above it. */
    @media (min-width: 900px) {
        .home-hero-media {
            align-self: end;
            margin-bottom: 0;
        }

        .home-hero-media .home-hero-slide {
            display: block;
        }
    }

    .home-hero-eyebrow {
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        margin-bottom: clamp(0.75rem, 2vw, 1.25rem);
    }

    .home-hero-title {
        font-family: var(--font-display);
        /* Sized so the longest word fits its column without breaking */
        font-size: clamp(2.25rem, 4.4vw, 3.9rem);
        line-height: 0.95;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        text-wrap: balance;
        margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
    }

    .home-hero-subtitle {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(1.25rem, 2.2vw, 1.75rem);
        line-height: 1.25;
        max-width: 22ch;
        margin-bottom: clamp(1rem, 2.5vw, 1.5rem);
    }

    .home-hero-dates {
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-bottom: clamp(1.5rem, 3.5vw, 2.5rem);
    }

    /* Text link rather than an outlined box — nothing else on the page is boxed */
    .home-hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid currentColor;
    }

    .home-hero-arrow {
        transition: transform 0.25s ease;
    }

    .home-hero-cta:hover .home-hero-arrow,
    .home-hero-cta:focus-visible .home-hero-arrow {
        transform: translateX(4px);
    }

    /* Image sits flush to the bottom of the blue block */
    .home-hero-media {
        align-self: end;
    }

    .home-hero-media img {
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 3;
        object-fit: cover;
    }

    /* Slides stack and crossfade; the first one sets the box height */
    .home-hero-track {
        display: grid;
    }

    .home-hero-slide {
        grid-area: 1 / 1;
        opacity: 0;
        transition: opacity 0.7s ease;
    }

    .home-hero-slide.active {
        opacity: 1;
    }

    .home-hero-dots {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.85rem;
    }

    .home-hero-dot {
        width: 28px;
        height: 2px;
        padding: 0;
        border: 0;
        cursor: pointer;
        background: currentColor;
        opacity: 0.3;
        transition: opacity 0.2s ease;
    }

    .home-hero-dot.active,
    .home-hero-dot:hover {
        opacity: 1;
    }

    .home-hero-dot:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 3px;
    }

    /* Keep the stacked image from dominating the fold on tablets */
    @media (max-width: 899px) {
        .home-hero-media img {
            aspect-ratio: 16 / 10;
            max-height: 50vh;
        }
    }

    .home-hero-rail {
        display: grid;
    }

    .home-hero-railset {
        grid-area: 1 / 1;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.25s ease,
            visibility 0s linear 0.25s;
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 4vw, 3rem);
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        line-height: 1.7;
        padding-bottom: clamp(2rem, 5vw, 4rem);
    }

    .home-hero-railset.active {
        opacity: 1;
        visibility: visible;
        transition:
            opacity 0.35s ease 0.15s,
            visibility 0s;
    }

    @media (min-width: 900px) {
        .home-hero-rail,
        .home-hero-railset {
            min-width: max-content;
        }
    }

    .home-hero-discipline {
        font-size: inherit;
        max-width: none;
        padding-bottom: clamp(1.5rem, 4vw, 3rem);
        border-bottom: 1px solid currentColor;
    }

    .home-hero-themes {
        list-style: none;
    }

    .home-hero-location {
        font-size: inherit;
        max-width: none;
    }

    /* Rail reads as a horizontal strip on narrow screens */
    @media (max-width: 899px) {
        .home-hero-railset {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 1rem 2rem;
            align-items: baseline;
        }

        .home-hero-discipline {
            border-bottom: none;
            padding-bottom: 0;
        }

        .home-hero-themes {
            display: flex;
            flex-wrap: wrap;
            gap: 0 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-hero-arrow,
        .home-hero-slide,
        .home-hero-copy,
        .home-hero-railset {
            transition: none;
        }
    }
</style>

<script>
    // Crossfade the hero gallery. Pauses on hover/focus and respects
    // reduced-motion by not auto-advancing.
    document.querySelectorAll("[data-hero-gallery]").forEach((root) => {
        const slides = Array.from(
            root.querySelectorAll<HTMLElement>(".home-hero-slide"),
        );
        // The copy lives outside the media element, so look it up on the hero
        const hero = root.closest(".home-hero");
        const copies = Array.from(
            hero?.querySelectorAll<HTMLElement>("[data-hero-copy]") ?? [],
        );
        const rails = Array.from(
            hero?.querySelectorAll<HTMLElement>("[data-hero-rail]") ?? [],
        );
        const dots = Array.from(
            root.querySelectorAll<HTMLButtonElement>(".home-hero-dot"),
        );
        if (slides.length < 2) return;

        let index = 0;
        let timer: number | null = null;
        const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        function show(next: number) {
            index = (next + slides.length) % slides.length;
            slides.forEach((s, i) => s.classList.toggle("active", i === index));
            dots.forEach((d, i) => d.classList.toggle("active", i === index));
            rails.forEach((r, i) => r.classList.toggle("active", i === index));
            copies.forEach((c, i) => {
                const on = i === index;
                c.classList.toggle("active", on);
                // Keep hidden copy out of the tab order
                c.querySelectorAll("a").forEach((a) =>
                    on ? a.removeAttribute("tabindex") : (a.tabIndex = -1),
                );
            });
        }

        function start() {
            if (reduced || timer !== null) return;
            timer = window.setInterval(() => show(index + 1), 7000);
        }

        function stop() {
            if (timer !== null) {
                clearInterval(timer);
                timer = null;
            }
        }

        dots.forEach((dot) =>
            dot.addEventListener("click", () => {
                show(Number(dot.dataset.index) || 0);
                stop();
                start();
            }),
        );

        root.addEventListener("mouseenter", stop);
        root.addEventListener("mouseleave", start);
        root.addEventListener("focusin", stop);
        root.addEventListener("focusout", start);

        start();
    });
</script>
