---
import { getLocalePath, type Locale } from "../lib/i18n";

interface Props {
    title: string;
    slug: string;
    image?: string;
    price: number;
    available?: boolean;
    description?: string;
    lang?: Locale;
}

const { title, slug, image, price, available = true, description, lang = "es" } = Astro.props;

const imageUrl = image || `https://picsum.photos/seed/${slug}/800/800`;
const formattedPrice = new Intl.NumberFormat(lang === "es" ? "es-ES" : "en-GB", {
    style: "currency",
    currency: "EUR",
}).format(price);
---

<a href={getLocalePath(`/tienda/${slug}`, lang)} class:list={["product-card", { unavailable: !available }]}>
    {!available && <span class="product-card-badge">{lang === "en" ? "Sold out" : "Agotado"}</span>}
    <div class="product-card-image">
        <img
            src={imageUrl}
            alt={title}
            width={800}
            height={800}
            loading="lazy"
            decoding="async"
        />
    </div>
    <div class="product-card-content">
        <h2 class="product-card-title">{title}</h2>
        {description && <p class="product-card-description">{description}</p>}
        <p class="product-card-price">{formattedPrice}</p>
    </div>
</a>
