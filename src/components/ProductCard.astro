---
interface Props {
    title: string;
    slug: string;
    image?: string;
    price: number;
    available?: boolean;
    description?: string;
}

const { title, slug, image, price, available = true, description } = Astro.props;

const imageUrl = image || `https://picsum.photos/seed/${slug}/800/800`;
const formattedPrice = new Intl.NumberFormat("es-ES", {
    style: "currency",
    currency: "EUR",
}).format(price);
---

<a href={`/tienda/${slug}`} class:list={["product-card", { unavailable: !available }]}>
    {!available && <span class="product-card-badge">Agotado</span>}
    <div class="product-card-image">
        <img
            src={imageUrl}
            alt={title}
            width={800}
            height={800}
            loading="lazy"
            decoding="async"
        />
    </div>
    <div class="product-card-content">
        <h2 class="product-card-title">{title}</h2>
        {description && <p class="product-card-description">{description}</p>}
        <p class="product-card-price">{formattedPrice}</p>
    </div>
</a>
