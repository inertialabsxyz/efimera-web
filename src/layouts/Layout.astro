---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SearchModal from "../components/SearchModal.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { getArticles, urlFor } from "../lib/sanity";

interface Props {
    title?: string;
    description?: string;
}

const { title = "Efímera", description = "Espacio de arte contemporáneo " } =
    Astro.props;

const isStaging = import.meta.env.PUBLIC_STAGING === "true";
const rawArticles = await getArticles();
const articles = rawArticles.map((article: any) => ({
    ...article,
    imageUrl: article.mainImage
        ? urlFor(article.mainImage).width(120).height(80).url()
        : null,
}));

const categories = [
    "Efímera",
    "Exposiciones",
    "Actividades",
    "Artistas",
    "Entrevistas",
    "Letras",
    "Efímera projects",
    "Tienda",
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <script is:inline>
            const theme =
                localStorage.getItem("theme") ||
                (window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light");
            document.documentElement.setAttribute("data-theme", theme);
        </script>
    </head>
    <body>
        {isStaging && <div class="staging-banner">STAGING</div>}
        <header class="site-header">
            <a href="/" class="site-logo">
                <img src="/efimera-logo.svg" alt="Efímera" class="logo-light" />
                <img
                    src="/efimera-logo-white.svg"
                    alt="Efímera"
                    class="logo-dark"
                />
            </a>

            <div class="header-right">
                <nav class="site-nav">
                    {
                        categories.map((category) => {
                            const isAll = category === "Efímera";
                            const isProjects = category === "Efímera projects";
                            const isTienda = category === "Tienda";
                            const href = isAll
                                ? "/"
                                : isProjects
                                  ? "/efimera-projects"
                                  : isTienda
                                    ? "/tienda"
                                    : `/category/${category.toLowerCase()}`;
                            const isActive = isAll
                                ? currentPath === "/"
                                : isProjects
                                  ? currentPath.startsWith("/efimera-projects")
                                  : isTienda
                                    ? currentPath.startsWith("/tienda")
                                    : currentPath.includes(
                                          category.toLowerCase(),
                                      );
                            return (
                                <a
                                    href={href}
                                    class:list={[{ active: isActive }]}
                                >
                                    {category}
                                </a>
                            );
                        })
                    }
                    <div class="nav-social">
                        <a href="mailto:info@efimera.xyz" aria-label="Email">
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <rect x="2" y="4" width="20" height="16" rx="2"
                                ></rect>
                                <path d="M22 6L12 13L2 6"></path>
                            </svg>
                        </a>
                        <a
                            href="https://www.instagram.com/_efimera_espacio_de_arte/"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Instagram"
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <rect
                                    x="2"
                                    y="2"
                                    width="20"
                                    height="20"
                                    rx="5"
                                    ry="5"></rect>
                                <path
                                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                                ></path>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                                ></line>
                            </svg>
                        </a>
                        <a
                            href="https://www.linkedin.com/company/ef%C3%ADmera/"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="LinkedIn"
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path
                                    d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                ></path>
                                <rect x="2" y="9" width="4" height="12"></rect>
                                <circle cx="4" cy="4" r="2"></circle>
                            </svg>
                        </a>
                        <a
                            href="https://open.spotify.com/playlist/3dkn2zpSR9MD5Y7aoJ8sUf?si=mJHbx5DMSf6vUxVl0bnxfw&pi=vlqQ7uFcQNS3s"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Spotify"
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M8 14.5c2.5-1 5.5-1 8 0"></path>
                                <path d="M7 11.5c3.5-1.5 7.5-1.5 11 0"></path>
                                <path d="M6 8.5c4.5-2 9.5-2 13 0"></path>
                            </svg>
                        </a>
                    </div>
                </nav>

                <div class="header-actions">
                    <a
                        href="/tienda/seleccion"
                        class="seleccion-link"
                        id="seleccion-link"
                        aria-label="Mi selección"
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                        <span class="seleccion-badge" id="seleccion-badge"></span>
                    </a>
                    <button
                        id="theme-toggle"
                        class="theme-toggle"
                        aria-label="Toggle theme"
                    >
                        <svg
                            class="icon-moon"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                            ></path>
                        </svg>
                        <svg
                            class="icon-sun"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
                            ></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
                            ></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
                            ></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
                            ></line>
                        </svg>
                    </button>
                    <button
                        id="search-button"
                        class="search-button"
                        aria-label="Buscar"
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="M21 21l-4.35-4.35"></path>
                        </svg>
                    </button>
                    <a href="mailto:info@efimera.xyz" aria-label="Email">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="M22 6L12 13L2 6"></path>
                        </svg>
                    </a>
                    <a href="https://www.instagram.com/_efimera_espacio_de_arte/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                    </a>
                    <a href="https://www.linkedin.com/company/ef%C3%ADmera/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                            <rect x="2" y="9" width="4" height="12"></rect>
                            <circle cx="4" cy="4" r="2"></circle>
                        </svg>
                    </a>
                    <a href="https://open.spotify.com/playlist/3dkn2zpSR9MD5Y7aoJ8sUf?si=mJHbx5DMSf6vUxVl0bnxfw&pi=vlqQ7uFcQNS3s" target="_blank" rel="noopener noreferrer" aria-label="Spotify">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M8 14.5c2.5-1 5.5-1 8 0"></path>
                            <path d="M7 11.5c3.5-1.5 7.5-1.5 11 0"></path>
                            <path d="M6 8.5c4.5-2 9.5-2 13 0"></path>
                        </svg>
                    </a>
                </div>

                <button
                    class="menu-toggle"
                    aria-label="Toggle menu"
                    aria-expanded="false"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <line x1="4" y1="7" x2="20" y2="7"></line>
                        <line x1="4" y1="12" x2="20" y2="12"></line>
                        <line x1="4" y1="17" x2="20" y2="17"></line>
                    </svg>
                </button>
            </div>
        </header>

        <main>
            <slot />
        </main>

        <footer class="site-footer">
            <div class="footer-left">
                <div class="footer-links">
                    <a href="/about">Acerca de</a>
                    <a href="/contact">Contacto</a>
                    <a href="/privacy">Privacidad</a>
                    <a href="/prensa">Prensa</a>
                </div>
                <p class="footer-copyright">
                    © {new Date().getFullYear()} Efímera
                </p>
            </div>
            <NewsletterForm variant="footer" />
        </footer>

        <SearchModal articles={articles} />

        <script>
            // Mobile menu toggle
            const menuToggle = document.querySelector(".menu-toggle");
            const nav = document.querySelector(".site-nav");

            menuToggle?.addEventListener("click", () => {
                const isOpen = nav?.classList.toggle("open");
                menuToggle.setAttribute("aria-expanded", String(isOpen));
            });

            // Search button
            const searchButton = document.getElementById("search-button");
            searchButton?.addEventListener("click", () => {
                if (typeof window.openSearchModal === "function") {
                    window.openSearchModal();
                }
            });

            // Theme toggle
            const themeToggle = document.getElementById("theme-toggle");
            themeToggle?.addEventListener("click", () => {
                const currentTheme =
                    document.documentElement.getAttribute("data-theme");
                const newTheme = currentTheme === "dark" ? "light" : "dark";
                document.documentElement.setAttribute("data-theme", newTheme);
                localStorage.setItem("theme", newTheme);
            });

            // Selección (inquiry list) helpers
            const SELECCION_KEY = "efimera-seleccion";

            function seleccionGet() {
                try {
                    return JSON.parse(localStorage.getItem(SELECCION_KEY) || "[]");
                } catch {
                    return [];
                }
            }

            function seleccionSave(items) {
                localStorage.setItem(SELECCION_KEY, JSON.stringify(items));
                document.dispatchEvent(new CustomEvent("seleccion-updated"));
            }

            window.seleccionGet = seleccionGet;
            window.seleccionCount = () => seleccionGet().length;
            window.seleccionClear = () => seleccionSave([]);

            window.seleccionAdd = (item) => {
                const items = seleccionGet();
                if (!items.some((i) => i.id === item.id)) {
                    items.push(item);
                    seleccionSave(items);
                }
            };

            window.seleccionRemove = (id) => {
                const items = seleccionGet().filter((i) => i.id !== id);
                seleccionSave(items);
            };

            window.seleccionHas = (id) => {
                return seleccionGet().some((i) => i.id === id);
            };

            // Badge update
            function updateBadge() {
                const badge = document.getElementById("seleccion-badge");
                if (!badge) return;
                const count = seleccionGet().length;
                badge.textContent = count > 0 ? String(count) : "";
                badge.style.display = count > 0 ? "flex" : "none";
            }

            document.addEventListener("seleccion-updated", updateBadge);
            updateBadge();
        </script>
        <Analytics />
    </body>
</html>

<style>
    .search-button,
    .theme-toggle,
    .seleccion-link {
        background: none;
        border: none;
        color: var(--color-text);
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s ease;
        text-decoration: none;
        position: relative;
    }

    .search-button:hover,
    .theme-toggle:hover,
    .seleccion-link:hover {
        color: var(--color-text-muted);
    }

    .seleccion-badge {
        position: absolute;
        top: -4px;
        right: -6px;
        background: var(--color-text);
        color: var(--color-bg);
        font-size: 0.6rem;
        font-weight: 600;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        display: none;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-left: auto;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    /* Theme toggle icons */
    .theme-toggle .icon-sun {
        display: none;
    }

    :global([data-theme="dark"]) .theme-toggle .icon-moon {
        display: none;
    }

    :global([data-theme="dark"]) .theme-toggle .icon-sun {
        display: block;
    }

    /* Logo switching for dark mode */
    .logo-dark {
        display: none;
    }

    :global([data-theme="dark"]) .logo-light {
        display: none;
    }

    :global([data-theme="dark"]) .logo-dark {
        display: block;
    }
</style>
