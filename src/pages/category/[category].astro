// ];

// const articles = allArticles.filter(
//     (a) => a.category.toLowerCase() === category,
// );
const displayTitle =
    categorySlug === "articulos"
        ? t("nav.articulos", lang)
        : t(`cat.${categoryTitle}`, lang) !== `cat.${categoryTitle}`
          ? t(`cat.${categoryTitle}`, lang)
          : categoryTitle;
---

<Layout title={`${displayTitle} — Efímera`}>
    {
        articles.length > 0 ? (
            <>
                <div class="editorial-grid">
                    {articles.map((article) =>
                        article._itemType === "revista" ? (
                            <EditorialCard
                                title={article.title}
                                href={article.pdfUrl}
                                image={
                                    article.mainImage
                                        ? urlFor(article.mainImage)
                                              .width(800)
                                              .height(600)
                                              .fit("crop")
                                              .url()
                                        : null
                                }
                                kicker="Revista"
                                excerpt={article.excerpt}
                                external
                                lang={lang}
                            />
                        ) : (
                            <EditorialCard
                                title={article.title}
                                href={getLocalePath(
                                    `/article/${article.slug.current}`,
                                    lang,
                                )}
                                image={
                                    article.mainImage
                                        ? urlFor(article.mainImage)
                                              .width(800)
                                              .height(600)
                                              .fit("crop")
                                              .url()
                                        : null
                                }
                                kicker={article.category}
                                excerpt={article.excerpt}
                                lang={lang}
                            />
                        )
                    )}
                </div>
                <Pagination
                    currentPage={currentPage}
                    totalPages={totalPages}
                    baseUrl={getLocalePath(`/category/${category}`, lang)}
                    lang={lang}
                />
            </>
        ) : (
            <div class="empty-state">
                <p>{t("empty.category", lang)}</p>
            </div>
        )
    }
</Layout>

<style>
    .empty-state {
        text-align: center;
        padding: 8rem 2rem;
        color: var(--color-text-muted);
    }
</style>
