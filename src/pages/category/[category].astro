---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Pagination from "../../components/Pagination.astro";
import {
    getArticlesByCategoryPaginated,
    getArticlesPaginated,
    getRevistas,
    urlFor,
} from "../../lib/sanity";
import { getLang, t, getLocalePath, type Locale } from "../../lib/i18n";

const lang = getLang(Astro);
const { category } = Astro.params;
const categoryTitle = category
    ? category.charAt(0).toUpperCase() + category.slice(1)
    : "";

// "Todos" means "All" in Spanish - show all articles
const isAll = category?.toLowerCase() === "todos";
const isLetras = category?.toLowerCase() === "letras";

const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam || "1", 10) || 1);

// For Letras, merge articles and revistas sorted by publishedAt
let articles: any[] = [];
let totalPages = 1;

if (isLetras) {
    const [letrasResult, revistas] = await Promise.all([
        getArticlesByCategoryPaginated("Letras", 1, 1000, lang),
        getRevistas(lang),
    ]);
    const allItems = [
        ...letrasResult.articles.map((a: any) => ({ ...a, _itemType: "article" })),
        ...(revistas || []).map((r: any) => ({
            ...r,
            _itemType: "revista",
            mainImage: r.coverImage,
            category: "Revista",
            slug: { current: r.slug?.current },
        })),
    ].sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

    const pageSize = 10;
    const start = (currentPage - 1) * pageSize;
    articles = allItems.slice(start, start + pageSize);
    totalPages = Math.ceil(allItems.length / pageSize);
} else if (isAll) {
    const result = await getArticlesPaginated(currentPage, 10, lang);
    articles = result.articles;
    totalPages = result.totalPages;
} else {
    const result = await getArticlesByCategoryPaginated(categoryTitle, currentPage, 10, lang);
    articles = result.articles;
    totalPages = result.totalPages;
}

