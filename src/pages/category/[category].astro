// ];

// const articles = allArticles.filter(
//     (a) => a.category.toLowerCase() === category,
// );
const displayTitle = t(`cat.${categoryTitle}`, lang) !== `cat.${categoryTitle}` ? t(`cat.${categoryTitle}`, lang) : categoryTitle;
---

<Layout title={`${displayTitle} — Efímera`}>
    {
        articles.length > 0 ? (
            <>
                <div class="article-grid">
                    {articles.map((article) =>
                        article._itemType === "revista" ? (
                            <a
                                href={article.pdfUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="article-card"
                            >
                                <span class="article-card-category">Revista</span>
                                <div class="article-card-image">
                                    {article.mainImage && (
                                        <img
                                            src={urlFor(article.mainImage)
                                                .width(800)
                                                .height(600)
                                                .url()}
                                            alt={article.mainImage?.alt || article.title}
                                            width="800"
                                            height="600"
                                            loading="lazy"
                                        />
                                    )}
                                </div>
                                <div class="article-card-content">
                                    <h2 class="article-card-title">{article.title}</h2>
                                    {article.excerpt && (
                                        <p class="article-card-excerpt">{article.excerpt}</p>
                                    )}
                                </div>
                            </a>
                        ) : (
                            <ArticleCard
                                title={article.title}
                                slug={article.slug.current}
                                category={article.category}
                                image={
                                    article.mainImage
                                        ? urlFor(article.mainImage)
                                              .width(800)
                                              .height(600)
                                              .url()
                                        : undefined
                                }
                                excerpt={article.excerpt}
                                lang={lang}
                            />
                        )
                    )}
                </div>
                <Pagination
                    currentPage={currentPage}
                    totalPages={totalPages}
                    baseUrl={getLocalePath(`/category/${category}`, lang)}
                    lang={lang}
                />
            </>
        ) : (
            <div class="empty-state">
                <p>{t("empty.category", lang)}</p>
            </div>
        )
    }
</Layout>

<style>
    .empty-state {
        text-align: center;
        padding: 8rem 2rem;
        color: var(--color-text-muted);
    }
</style>
