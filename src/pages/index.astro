---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import FeaturedGallery from "../components/FeaturedGallery.astro";
import Pagination from "../components/Pagination.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import {
    getArticlesPaginated,
    getFeaturedGallery,
    urlFor,
} from "../lib/sanity";
import { getLang, getLocalePath, type Locale } from "../lib/i18n";

const lang = getLang(Astro);
const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam || "1", 10) || 1);

const { articles, totalPages } = await getArticlesPaginated(currentPage, 10, lang);
const featuredGallery = await getFeaturedGallery(lang);
---

<Layout title="Efímera">
    {
        featuredGallery?.slides && featuredGallery.slides.length > 0 && (
            <>
                <FeaturedGallery slides={featuredGallery.slides} lang={lang} />
                <hr class="gallery-divider" />
            </>
        )
    }

    <div class="article-grid">
        {
            articles.map((article) => (
                <ArticleCard
                    title={article.title}
                    slug={article.slug.current}
                    category={article.category}
                    image={
                        article.mainImage
                            ? urlFor(article.mainImage)
                                  .width(800)
                                  .height(600)
                                  .url()
                            : undefined
                    }
                    excerpt={article.excerpt}
                    lang={lang}
                />
            ))
        }
    </div>

    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={getLocalePath("/", lang)} lang={lang} />

    <NewsletterForm variant="homepage" lang={lang} />
</Layout>
