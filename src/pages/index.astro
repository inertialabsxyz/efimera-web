---
import Layout from "../layouts/Layout.astro";
import EditorialCard from "../components/EditorialCard.astro";
import HomeHero from "../components/HomeHero.astro";
import HomeFeatureRow from "../components/HomeFeatureRow.astro";
import Pagination from "../components/Pagination.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import {
    getArticlesPaginated,
    getHeroSlides,
    urlFor,
} from "../lib/sanity";
import { getLang, getLocalePath, t } from "../lib/i18n";

const FEATURE_COUNT = 3;
const GRID_SIZE = 6;

const lang = getLang(Astro);
const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam || "1", 10) || 1);

// Every page carries the hero and the feature row: three feature cards
// plus a six-card grid, so nine per page and both rows divide by three.
const pageSize = FEATURE_COUNT + GRID_SIZE;

// Fetch the hero first so the articles it links to can be excluded in the
// query. Filtering after the fact would leave pages short.
const heroSlides = await getHeroSlides(lang);
const slideSlugs = heroSlides
    .map((s: any) => s?.article?.slug?.current)
    .filter(Boolean);

const { articles, total } = await getArticlesPaginated(
    currentPage,
    pageSize,
    lang,
    slideSlugs,
);

// The featured gallery IS the hero: each slide carries its own image, text,
// dates and rail metadata, and they rotate together. Nothing renders when the
// gallery is empty.
const hasHero = heroSlides.length > 0;

const totalPages = Math.max(1, Math.ceil(total / pageSize));

// A page past the end would render an empty grid and a "9 / 8" label
if (currentPage > totalPages) {
    return Astro.redirect(getLocalePath("/", lang));
}

// The three feature cards come off the top of the list; the grid below
// continues from where they stop.
const featureItems = articles.slice(0, FEATURE_COUNT);
const gridArticles = articles.slice(FEATURE_COUNT);
---

<Layout title="Efímera" transparentHeader={hasHero}>
    {hasHero && <HomeHero slides={heroSlides} lang={lang} />}

    {
        featureItems.length > 0 && (
            <>
                <div id="articles" class="articles-anchor" />
                <HomeFeatureRow items={featureItems} lang={lang} />
            </>
        )
    }

    <div class="editorial-grid">
        {
            gridArticles.map((article: any) => (
                <EditorialCard
                    title={article.title}
                    href={getLocalePath(
                        `/article/${article.slug.current}`,
                        lang,
                    )}
                    image={
                        article.mainImage
                            ? urlFor(article.mainImage)
                                  .width(800)
                                  .height(600)
                                  .fit("crop")
                                  .url()
                            : null
                    }
                    kicker={article.category}
                    excerpt={article.excerpt}
                    lang={lang}
                />
            ))
        }
    </div>

    <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={getLocalePath("/", lang)}
        lang={lang}
        anchor="articles"
    />

    <div id="newsletter">
        <NewsletterForm variant="homepage" lang={lang} />
    </div>
</Layout>
