---
import Layout from "../layouts/Layout.astro";
import EditorialCard from "../components/EditorialCard.astro";
import HomeHero from "../components/HomeHero.astro";
import HomeFeatureRow from "../components/HomeFeatureRow.astro";
import Pagination from "../components/Pagination.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import {
    getArticlesPaginated,
    getHeroSlides,
    getHomeHero,
    urlFor,
} from "../lib/sanity";
import { homeHeroPlaceholder } from "../data/homeHeroPlaceholder";
import { getLang, getLocalePath, t } from "../lib/i18n";

const lang = getLang(Astro);
const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam || "1", 10) || 1);

const [{ articles, totalPages }, authoredHero, heroSlides] = await Promise.all([
    getArticlesPaginated(currentPage, 10, lang),
    getHomeHero(lang),
    getHeroSlides(lang),
]);

// The featured gallery supplies the hero: each slide carries its own title,
// description and dates. Slides that leave those blank fall back to their
// linked article inside HomeHero. The derived hero below is only used when
// the gallery is empty.
const leadArticle = articles[0];

// Short excerpts are usually just the date/time repeated, which the hero
// already shows on its own line — only use longer ones as a subtitle.
const heroSubtitle =
    leadArticle?.excerpt && leadArticle.excerpt.trim().length > 60
        ? leadArticle.excerpt
        : null;

const derivedHero = leadArticle
    ? {
          eyebrow: leadArticle.category,
          title: leadArticle.title,
          subtitle: heroSubtitle,
          startDate: leadArticle.publishedAt,
          endDate: null,
          image: null,
          themes: [],
          discipline: null,
          location: null,
          article: { slug: leadArticle.slug },
      }
    : null;

const hero = authoredHero ?? derivedHero ?? homeHeroPlaceholder;

// The three feature cards come off the top of the article list; the grid
// below continues from where they stop so nothing is shown twice.
const isFirstPage = currentPage === 1;

// Don't repeat the hero's article in the cards below it. With a populated
// gallery the hero links to its slides, so dedupe against those too.
const slideSlugs = new Set(
    (heroSlides ?? [])
        .map((s: any) => s?.article?.slug?.current)
        .filter(Boolean),
);
const heroSlug = hero?.article?.slug?.current ?? null;
if (heroSlug && slideSlugs.size === 0) slideSlugs.add(heroSlug);
const available = isFirstPage
    ? articles.filter((a: any) => !slideSlugs.has(a.slug?.current))
    : articles;

const featureItems = isFirstPage ? available.slice(0, 3) : [];
const gridArticles = isFirstPage ? available.slice(3) : available;
---

<Layout title="Efímera" transparentHeader={Boolean(hero) && isFirstPage}>
    {
        hero && isFirstPage && (
            <HomeHero hero={hero} slides={heroSlides} lang={lang} />
        )
    }

    {
        featureItems.length > 0 && (
            <HomeFeatureRow items={featureItems} lang={lang} />
        )
    }

    <div class="editorial-grid">
        {
            gridArticles.map((article: any) => (
                <EditorialCard
                    title={article.title}
                    href={getLocalePath(
                        `/article/${article.slug.current}`,
                        lang,
                    )}
                    image={
                        article.mainImage
                            ? urlFor(article.mainImage)
                                  .width(800)
                                  .height(600)
                                  .fit("crop")
                                  .url()
                            : null
                    }
                    kicker={article.category}
                    excerpt={article.excerpt}
                    lang={lang}
                />
            ))
        }
    </div>

    <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={getLocalePath("/nueva", lang)}
        lang={lang}
    />

    <div id="newsletter">
        <NewsletterForm variant="homepage" lang={lang} />
    </div>
</Layout>
