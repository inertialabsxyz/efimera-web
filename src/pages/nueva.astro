---
import Layout from "../layouts/Layout.astro";
import EditorialCard from "../components/EditorialCard.astro";
import HomeHero from "../components/HomeHero.astro";
import HomeFeatureRow from "../components/HomeFeatureRow.astro";
import Pagination from "../components/Pagination.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import {
    getArticlesPaginated,
    getHeroSlides,
    urlFor,
} from "../lib/sanity";
import { getLang, getLocalePath, t } from "../lib/i18n";

const FEATURE_COUNT = 3;
const GRID_SIZE = 9;

const lang = getLang(Astro);
const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam || "1", 10) || 1);

// Every page carries the hero and the feature row, so page sizes are
// uniform: three feature cards plus a nine-card grid.
const pageSize = FEATURE_COUNT + GRID_SIZE;

const [{ articles, total }, heroSlides] = await Promise.all([
    getArticlesPaginated(currentPage, pageSize, lang),
    getHeroSlides(lang),
]);

// The featured gallery IS the hero: each slide carries its own image, text,
// dates and rail metadata, and they rotate together. Nothing renders when the
// gallery is empty.
const hasHero = heroSlides.length > 0;

const totalPages = Math.max(1, Math.ceil(total / pageSize));

// A page past the end would render an empty grid and a "9 / 8" label
if (currentPage > totalPages) {
    return Astro.redirect(getLocalePath("/nueva", lang));
}

// The three feature cards come off the top of the article list; the grid
// below continues from where they stop so nothing is shown twice.
// Don't repeat any article the hero already links to
const slideSlugs = new Set(
    heroSlides
        .map((s: any) => s?.article?.slug?.current)
        .filter(Boolean),
);
const available = articles.filter(
    (a: any) => !slideSlugs.has(a.slug?.current),
);

const featureItems = available.slice(0, FEATURE_COUNT);
const gridArticles = available.slice(FEATURE_COUNT);
---

<Layout title="Efímera" transparentHeader={hasHero}>
    {hasHero && <HomeHero slides={heroSlides} lang={lang} />}

    {
        featureItems.length > 0 && (
            <>
                <div id="articles" class="articles-anchor" />
                <HomeFeatureRow items={featureItems} lang={lang} />
            </>
        )
    }

    <div class="editorial-grid">
        {
            gridArticles.map((article: any) => (
                <EditorialCard
                    title={article.title}
                    href={getLocalePath(
                        `/article/${article.slug.current}`,
                        lang,
                    )}
                    image={
                        article.mainImage
                            ? urlFor(article.mainImage)
                                  .width(800)
                                  .height(600)
                                  .fit("crop")
                                  .url()
                            : null
                    }
                    kicker={article.category}
                    excerpt={article.excerpt}
                    lang={lang}
                />
            ))
        }
    </div>

    <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={getLocalePath("/nueva", lang)}
        lang={lang}
        anchor="articles"
    />

    <div id="newsletter">
        <NewsletterForm variant="homepage" lang={lang} />
    </div>
</Layout>
