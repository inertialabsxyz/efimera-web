---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import HomeHero from "../components/HomeHero.astro";
import HomeFeatureRow from "../components/HomeFeatureRow.astro";
import Pagination from "../components/Pagination.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { getArticlesPaginated, getHomeHero, urlFor } from "../lib/sanity";
import { homeHeroPlaceholder } from "../data/homeHeroPlaceholder";
import { getLang, getLocalePath, t } from "../lib/i18n";

const lang = getLang(Astro);
const pageParam = Astro.url.searchParams.get("page");
const currentPage = Math.max(1, parseInt(pageParam || "1", 10) || 1);

const [{ articles, totalPages }, authoredHero] = await Promise.all([
    getArticlesPaginated(currentPage, 10, lang),
    getHomeHero(lang),
]);

// Authored content wins; the placeholder keeps the layout visible while the
// design is being worked on. Remove the fallback once Sanity is populated.
const hero = authoredHero ?? homeHeroPlaceholder;

// The three feature cards come off the top of the article list; the grid
// below continues from where they stop so nothing is shown twice.
const isFirstPage = currentPage === 1;

// Don't repeat the hero's article in the cards below it
const heroSlug = hero?.article?.slug?.current ?? null;
const available = isFirstPage
    ? articles.filter((a: any) => a.slug?.current !== heroSlug)
    : articles;

const featureItems = isFirstPage ? available.slice(0, 3) : [];
const gridArticles = isFirstPage ? available.slice(3) : available;
---

<Layout title="Efímera" transparentHeader={Boolean(hero) && isFirstPage}>
    {hero && isFirstPage && <HomeHero hero={hero} lang={lang} />}

    {
        featureItems.length > 0 && (
            <HomeFeatureRow items={featureItems} lang={lang} />
        )
    }

    <div class="article-grid">
        {
            gridArticles.map((article: any) => (
                <ArticleCard
                    title={article.title}
                    slug={article.slug.current}
                    category={article.category}
                    image={
                        article.mainImage
                            ? urlFor(article.mainImage)
                                  .width(800)
                                  .height(600)
                                  .url()
                            : undefined
                    }
                    excerpt={article.excerpt}
                    lang={lang}
                />
            ))
        }
    </div>

    <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={getLocalePath("/nueva", lang)}
        lang={lang}
    />

    <div id="newsletter">
        <NewsletterForm variant="homepage" lang={lang} />
    </div>
</Layout>
