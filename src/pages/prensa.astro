---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getPrensa, urlFor } from "../lib/sanity";
import { getLang, t, getLocalePath, type Locale } from "../lib/i18n";

const lang = getLang(Astro);
const prensaItems = await getPrensa(lang);
---

<Layout title="Prensa — Efímera">
    {
        prensaItems && prensaItems.length > 0 ? (
            <div class="prensa-grid">
                {prensaItems.map((prensa) => (
                    <a
                        href={getLocalePath(`/prensa/${prensa.slug.current}`, lang)}
                        class="prensa-card"
                    >
                        <div class="prensa-card-image">
                            <img
                                src={
                                    prensa.coverImage
                                        ? urlFor(prensa.coverImage).url()
                                        : undefined
                                }
                                alt={prensa.coverImage?.alt || prensa.title}
                                loading="lazy"
                            />
                        </div>
                        <div class="prensa-card-content">
                            <h2 class="prensa-card-title">{prensa.title}</h2>
                            {prensa.excerpt && (
                                <p class="prensa-card-excerpt">
                                    {prensa.excerpt}
                                </p>
                            )}
                        </div>
                    </a>
                ))}
            </div>
        ) : (
            <div class="empty-state">
                <p>{t("empty.prensa", lang)}</p>
            </div>
        )
    }
</Layout>

<style>
    .empty-state {
        text-align: center;
        padding: 8rem 2rem;
        color: var(--color-text-muted);
    }
</style>
