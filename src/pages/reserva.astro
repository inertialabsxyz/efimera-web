---
import Layout from "../layouts/Layout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import { getLang, t } from "../lib/i18n";

const lang = getLang(Astro);

const spaceImages = [
    "EFIMERA-1 ESPACIOS X_Z.jpg",
    "EFIMERA-1 ESPACIO Y.jpg",
    "EFIMERA-1 ESPACIO Z.jpg",
    "EFIMERA-2 ESPACIO Y.jpg",
    "EFIMERA-2.ESPACIO Y.jpg",
    "EFIMERA-3 ESPACIOS Y_Z.jpg",
    "EFIMERA-3 SPACIO Y.jpg",
    "EFIMERA-4 ESCALERA_ ESPACIO Y.jpg",
    "EFIMERA-5  ESPACIOS Y_X.jpg",
    "EFIMERA-6 ESPACIO Y_Z.jpg",
    "EFIMERA-7. ESPACIO Y_Z.jpg",
    "EFIMERA-7 ASEO.jpg",
    "EFIMERA-11.jpg",
    "EFIMERA-14.jpg",
    "EFIMERA-28.jpg",
].map((file) => ({
    url: `/espacio/${encodeURIComponent(file)}`,
    alt: "Efímera espacio",
}));

const planUrl = `/${encodeURIComponent("2025 EFIMERA C&S.pdf")}`;
---

<Layout
    title={`${t("reserva.title", lang)} | Efímera`}
    description={t("reserva.headline", lang)}
>
    <div class="page-content">
        <h1>{t("reserva.headline", lang)}</h1>
        <p class="lead">{t("reserva.intro", lang)}</p>
        <p>{t("reserva.description", lang)}</p>

        <div class="space-gallery">
            <ImageCarousel images={spaceImages} articleTitle="Efímera espacio" />
        </div>

        <a class="plan-link" href={planUrl} download="Efimera-plano.pdf">
            {t("reserva.plan", lang)} ↓
        </a>

        <div class="rental">
            <p>{t("reserva.rental", lang)}</p>
        </div>

        <div class="extras">
            <h2>{t("reserva.extrasTitle", lang)}</h2>
            <p>{t("reserva.extras", lang)}</p>
        </div>

        <a class="cta" href="mailto:info@efimera.xyz">
            {t("reserva.cta", lang)} — info@efimera.xyz
        </a>

        <p class="availability">{t("reserva.availability", lang)}</p>
    </div>
</Layout>

<style>
    .page-content {
        max-width: 680px;
        margin: 0 auto;
        padding: var(--space-md) var(--space-md) var(--space-lg);
    }

    h1 {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 400;
        margin-bottom: var(--space-sm);
    }

    h2 {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: var(--space-sm);
    }

    p {
        font-family: var(--font-display);
        font-size: 1.25rem;
        line-height: 1.6;
        margin-bottom: var(--space-sm);
    }

    .lead {
        font-size: clamp(1.35rem, 3vw, 1.6rem);
        line-height: 1.4;
        margin-bottom: var(--space-md);
    }

    .space-gallery {
        margin: var(--space-md) 0 var(--space-sm);
        aspect-ratio: 3 / 2;
    }

    .plan-link {
        display: inline-block;
        font-family: var(--font-display);
        font-size: 1rem;
        letter-spacing: 0.05em;
        color: var(--color-text-muted);
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 0.15rem;
        transition:
            color 0.2s ease,
            border-color 0.2s ease;
    }

    .plan-link:hover {
        color: var(--color-text);
        border-color: var(--color-text);
    }

    .rental {
        border: 1px solid var(--color-border);
        background: var(--color-card-bg);
        padding: var(--space-sm) var(--space-md);
        margin: var(--space-md) 0;
    }

    .rental p {
        margin-bottom: 0;
    }

    .extras {
        margin-bottom: var(--space-md);
    }

    .extras p {
        margin-bottom: 0;
    }

    .cta {
        display: inline-block;
        font-family: var(--font-display);
        font-size: 1rem;
        letter-spacing: 0.05em;
        border: 1px solid var(--color-text);
        padding: 0.75rem 1.5rem;
        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .cta:hover {
        background: var(--color-text);
        color: var(--color-bg);
    }

    .availability {
        font-size: 0.9rem;
        font-style: italic;
        color: var(--color-text-muted);
        border-top: 1px solid var(--color-border);
        margin-top: var(--space-md);
        padding-top: var(--space-sm);
        margin-bottom: 0;
    }
</style>
