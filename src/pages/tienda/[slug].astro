---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import ImageCarousel from "../../components/ImageCarousel.astro";
import { getProduct, urlFor } from "../../lib/sanity";
import { toHTML } from "@portabletext/to-html";
import { getLang, t, getLocalePath, type Locale } from "../../lib/i18n";

const lang = getLang(Astro);
const { slug } = Astro.params;
const product = await getProduct(slug, lang);

if (!product) {
    return Astro.redirect("/404");
}

const formattedPrice = new Intl.NumberFormat("es-ES", {
    style: "currency",
    currency: "EUR",
}).format(product.price);

// Prepare gallery images
const hasGallery = product.gallery && product.gallery.length > 0;
const galleryImages = hasGallery
    ? product.gallery.map((img: any) => ({
          url: urlFor(img).url(),
          alt: img.alt || product.title,
      }))
    : product.mainImage
      ? [
            {
                url: urlFor(product.mainImage).url(),
                alt: product.mainImage.alt || product.title,
            },
        ]
      : [
            {
                url: `https://picsum.photos/seed/${slug}/800/800`,
                alt: product.title,
            },
        ];

// Convert Portable Text to HTML
function renderImage({ value }: { value: any }) {
    if (!value?.asset?._ref) {
        return "";
    }
    const imgUrl = urlFor(value).width(1200).url();
    const alt = value.alt || "";
    const caption = value.caption
        ? `<figcaption>${value.caption}</figcaption>`
        : "";
    const img = `<img src="${imgUrl}" alt="${alt}" />`;
    return `<figure>${img}${caption}</figure>`;
}

const bodyHtml = product.body
    ? toHTML(product.body, {
          components: {
              types: {
                  image: renderImage,
              },
          },
      })
    : "";

// Product data for selection
const productData = JSON.stringify({
    id: product._id,
    slug: product.slug.current,
    title: product.title,
    price: product.price,
    image: galleryImages[0]?.url || "",
});

---

<Layout title={`${product.title} — ${t("tienda.title", lang)} — Efímera`}>
    <div class="product-detail">
        <a href={product.artist?.slug ? getLocalePath(`/tienda/artista/${product.artist.slug.current}`, lang) : getLocalePath("/tienda", lang)} class="product-back-link">&larr; {t("tienda.backToStore", lang)}</a>

        <div class="product-detail-layout">
            <div class="product-detail-images">
                <ImageCarousel
                    images={galleryImages}
                    articleTitle={product.title}
                />
            </div>

            <div class="product-detail-info">
                <h1 class="product-detail-title">{product.title}</h1>
                <p class="product-detail-price">{formattedPrice}</p>

                {product.available === false && (
                    <p class="product-detail-unavailable">{t("tienda.soldOut", lang)}</p>
                )}

                {product.description && (
                    <p class="product-detail-description">{product.description}</p>
                )}

                {product.available !== false && (
                    <button
                        class="product-inquiry-btn"
                        id="add-to-seleccion"
                        data-product={productData}
                        data-label-add={t("tienda.addToSelection", lang)}
                        data-label-added={`${t("tienda.added", lang)} ✓`}
                        data-label-in-selection={t("tienda.inSelection", lang)}
                        data-seleccion-url={getLocalePath("/tienda/seleccion", lang)}
                    >
                        {t("tienda.addToSelection", lang)}
                    </button>
                )}

                {bodyHtml && (
                    <div class="product-detail-body" set:html={bodyHtml} />
                )}
            </div>
        </div>
    </div>
</Layout>

<script>
    const btn = document.getElementById("add-to-seleccion");
    if (btn) {
        const product = JSON.parse(btn.dataset.product || "{}");
        const labelAdd = btn.dataset.labelAdd || "Add to my selection";
        const labelAdded = btn.dataset.labelAdded || "Added";
        const labelInSelection = btn.dataset.labelInSelection || "Already in your selection";
        const seleccionUrl = btn.dataset.seleccionUrl || "/tienda/seleccion";

        function updateButtonState() {
            if (window.seleccionHas && window.seleccionHas(product.id)) {
                btn.textContent = labelInSelection;
                btn.classList.add("added");
            }
        }

        updateButtonState();

        btn.addEventListener("click", () => {
            if (window.seleccionHas && window.seleccionHas(product.id)) {
                window.location.href = seleccionUrl;
                return;
            }
            if (window.seleccionAdd) {
                window.seleccionAdd(product);
                btn.textContent = labelAdded;
                btn.classList.add("added");
                setTimeout(() => {
                    btn.textContent = labelInSelection;
                }, 1500);
            }
        });
    }
</script>
