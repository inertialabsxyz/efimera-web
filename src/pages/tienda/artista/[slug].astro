---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getArtist, getProductsByArtistPaginated, urlFor } from "../../../lib/sanity";
import { getLang, t, getLocalePath, type Locale } from "../../../lib/i18n";

const lang = getLang(Astro);
const { slug } = Astro.params;
const artist = await getArtist(slug);

if (!artist) {
    return Astro.redirect("/404");
}

const page = parseInt(Astro.url.searchParams.get("page") || "1");
const { products, totalPages } = await getProductsByArtistPaginated(artist._id, page, 8, lang);
---

<Layout title={`${artist.name} — ${t("tienda.title", lang)} — Efímera`}>
    <div class="store-header">
        <a href={getLocalePath("/tienda", lang)} class="back-link">&larr; {t("tienda.title", lang)}</a>
        <h1 class="store-title">{artist.name}</h1>
    </div>

    {products && products.length > 0 ? (
        <div class="product-grid">
            {products.map((product, index) => (
                <div class="product-grid-item" style={`animation-delay: ${index * 0.05}s`}>
                    <ProductCard
                        title={product.title}
                        slug={product.slug.current}
                        image={product.mainImage ? urlFor(product.mainImage).width(800).height(800).url() : undefined}
                        price={product.price}
                        available={product.available !== false}
                        description={product.description}
                        lang={lang}
                    />
                </div>
            ))}
        </div>
    ) : (
        <div class="empty-state">
            <p>{t("empty.products", lang)}</p>
        </div>
    )}

    <Pagination
        currentPage={page}
        totalPages={totalPages}
        baseUrl={getLocalePath(`/tienda/artista/${artist.slug.current}`, lang)}
        lang={lang}
    />

    {artist.relatedArticles && artist.relatedArticles.length > 0 && (
        <section class="related-articles">
            <h2>{t("article.related", lang)}</h2>
            <div class="related-articles-grid">
                {artist.relatedArticles.map((related: any) => (
                    <a
                        href={getLocalePath(`/article/${related.slug.current}`, lang)}
                        class="related-article-card"
                    >
                        {related.mainImage && (
                            <div class="related-article-image">
                                <img
                                    src={urlFor(related.mainImage).width(800).height(800).url()}
                                    alt={related.title}
                                    loading="lazy"
                                />
                            </div>
                        )}
                        <div class="related-article-content">
                            <span class="related-article-category">{related.category}</span>
                            <h3>{related.title}</h3>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )}
</Layout>

<style>
    .back-link {
        display: inline-block;
        margin-bottom: var(--space-sm);
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .back-link:hover {
        color: var(--color-text);
    }

    .empty-state {
        text-align: center;
        padding: 8rem 2rem;
        color: var(--color-text-muted);
    }

    .related-articles {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-md);
        border-top: 1px solid var(--color-border);
        padding-top: var(--space-lg);
    }

    .related-articles h2 {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: var(--space-md);
        color: var(--color-text-muted);
    }

    .related-articles-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-lg) var(--space-sm);
    }

    @media (max-width: 1024px) {
        .related-articles-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 768px) {
        .related-articles-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .related-article-card {
        text-decoration: none;
        color: inherit;
    }

    .related-article-image {
        aspect-ratio: 1/1;
        overflow: hidden;
        background: #f5f5f5;
        margin-bottom: var(--space-xs);
    }

    .related-article-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .related-article-card:hover .related-article-image img {
        transform: scale(1.03);
    }

    .related-article-category {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
    }

    .related-article-content h3 {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 400;
        margin-top: 0.25rem;
        text-transform: uppercase;
    }

    @media (max-width: 480px) {
        .related-articles-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
