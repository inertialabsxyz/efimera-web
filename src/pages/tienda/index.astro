---
import Layout from "../../layouts/Layout.astro";
import { getArtists, urlFor } from "../../lib/sanity";

const artists = await getArtists();
---

<Layout title="Tienda — Efímera">
    <div class="store-header">
        <h1 class="store-title">Tienda</h1>
    </div>

    {artists && artists.length > 0 ? (
        <div class="artist-grid">
            {artists.map((artist, index) => (
                <div class="artist-grid-item" style={`animation-delay: ${index * 0.05}s`}>
                    <a href={`/tienda/artista/${artist.slug.current}`} class="artist-card">
                        <div class="artist-card-image">
                            {artist.image ? (
                                <img
                                    src={urlFor(artist.image).width(800).height(800).url()}
                                    alt={artist.image.alt || artist.name}
                                    loading="lazy"
                                />
                            ) : (
                                <div class="artist-card-placeholder" />
                            )}
                        </div>
                        <div class="artist-card-content">
                            <h2 class="artist-card-name">{artist.name}</h2>
                        </div>
                    </a>
                </div>
            ))}
        </div>
    ) : (
        <div class="empty-state">
            <p>Aún no hay artistas disponibles.</p>
        </div>
    )}
</Layout>

<style>
    .artist-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-xl) var(--space-lg);
        padding: var(--space-lg);
        max-width: var(--max-width);
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        .artist-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 480px) {
        .artist-grid {
            grid-template-columns: 1fr;
        }
    }

    .artist-grid-item {
        opacity: 0;
        animation: slideUp 0.6s ease forwards;
    }

    .artist-card {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .artist-card-image {
        aspect-ratio: 1/1;
        overflow: hidden;
    }

    .artist-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .artist-card:hover .artist-card-image img {
        transform: scale(1.03);
    }

    .artist-card-placeholder {
        width: 100%;
        height: 100%;
        background: var(--color-card-bg);
    }

    .artist-card-content {
        padding: var(--space-xs) 0;
    }

    .artist-card-name {
        font-size: 1rem;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .empty-state {
        text-align: center;
        padding: 8rem 2rem;
        color: var(--color-text-muted);
    }
</style>
